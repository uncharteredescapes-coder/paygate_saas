{
  "$schema": "https://gate-ui.dev/schema/1",
  "name": "Gate UI",
  "version": "3.0.0",
  "principle": "calm, precise, fast — quiet canvas, single accent, data in monospace, motion only where state changes",
  "colors": {
    "light": {
      "bg": "#FAFAF9",
      "surface": "#FFFFFF",
      "surface-2": "#F4F4F2",
      "border": "#E7E7E3",
      "ink": "#0E0E11",
      "ink-2": "#55555E",
      "ink-3": "#8A8A94",
      "accent": "#5B5BF0",
      "accent-soft": "#EEEEFF",
      "success": "#12B76A",
      "warning": "#F79009",
      "danger": "#F04438"
    },
    "dark": {
      "bg": "#0B0B0E",
      "surface": "#141418",
      "surface-2": "#1C1C22",
      "border": "#2A2A31",
      "ink": "#F5F5F7",
      "ink-2": "#A4A4AE",
      "ink-3": "#6F6F7A",
      "accent": "#8B8BFF",
      "accent-soft": "#23234A",
      "success": "#32D583",
      "warning": "#FDB022",
      "danger": "#F97066"
    },
    "providers": {
      "bkash": "#E2136E",
      "nagad": "#F6921E",
      "rocket": "#8C3494"
    }
  },
  "typography": {
    "families": {
      "ui": "Inter, system-ui, sans-serif",
      "bengali": "'Noto Sans Bengali', Inter, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, Menlo, monospace"
    },
    "scale": {
      "display": { "size": 32, "line": 40 },
      "h1": { "size": 24, "line": 32 },
      "h2": { "size": 20, "line": 28 },
      "h3": { "size": 16, "line": 24 },
      "body": { "size": 14, "line": 22 },
      "caption": { "size": 12, "line": 16 },
      "mono": { "size": 13, "line": 20 }
    }
  },
  "shape": {
    "grid": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
    "radius": { "input": 8, "chip": 8, "button": 12, "card": 16, "sheet": 24, "pill": 9999 },
    "elevation": ["hairline border only", "single soft popover shadow"]
  },
  "motion": {
    "hover_ms": 120,
    "state_ms": 200,
    "sheet_ms": 320,
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "reduced_motion": "honored via prefers-reduced-motion"
  },
  "sizing": { "control_height": 40, "control_height_mobile": 48, "input_height": 44, "touch_target": 44, "table_row": 48 }
}
